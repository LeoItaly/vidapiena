---
export const prerender = false;

import { ADMIN_USERS, SESSION_SECRET, TURNSTILE_SECRET_KEY } from 'astro:env/server';
import AdminBase from '../../layouts/AdminBase.astro';
import { parseUsers, authenticate, issueSession, resolveSession } from '../../lib/admin/session';
import { isUsableSecret } from '../../lib/admin/crypto';
import { checkLoginRate } from '../../lib/admin/rate-limit';
import { verifyTurnstile } from '../../lib/admin/turnstile';
import { getLoginLimiter, getClientIp, isSecureRequest } from '../../lib/admin/runtime';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const ip = getClientIp(Astro);

/**
 * Largest login form we will read.
 *
 * `formData()` parses the whole body before any check can reject it, and this is
 * an *unauthenticated* endpoint — so without a bound, one anonymous POST of a
 * 20 MB multipart body spends the entire 10 ms CPU allowance, and the public
 * marketing site shares this Worker. A real login is a few hundred bytes.
 */
const MAX_LOGIN_BODY = 4 * 1024;
const users = parseUsers(ADMIN_USERS);
const configured = isUsableSecret(SESSION_SECRET) && users.length > 0;

/**
 * Italian, and deliberately vague about *why* a login failed: telling a stranger
 * "that email doesn't exist" hands them a list of valid accounts. Francesco has
 * one account and knows his own address, so the vagueness costs him nothing.
 */
const MESSAGES = {
  credenziali: 'Email o password non corretti. Riprova.',
  bloccato: 'Troppi tentativi. Aspetta un minuto e riprova.',
  /** Turnstile said no. Reloading genuinely can help here. */
  robot: 'Verifica di sicurezza non superata. Ricarica la pagina e riprova.',
  /**
   * Turnstile could not be reached, or its widget never rendered. Telling him to
   * reload would be a lie — no number of retries fixes either cause, and every
   * attempt counts toward the 15-minute lockout. Point him at Leo instead.
   */
  verifica:
    'Non riesco a completare il controllo di sicurezza. Se hai una connessione debole riprova fra poco; se continua, scrivi a Leo.',
  configurazione:
    'Il pannello non è ancora configurato. Scrivi a Leo — non è un problema del tuo accesso.',
} as const;

type MessageKey = keyof typeof MESSAGES;

let error: MessageKey | null = null;

/**
 * Prefilled from `?email=` so the link Leo sends already carries it.
 *
 * On a single-user portal, making him type an email address exactly right on a
 * phone keyboard is pure friction — and a typo is deliberately indistinguishable
 * from a wrong password, so he would have no idea which half he got wrong.
 * The address is not a secret; the password is.
 */
let email = Astro.url.searchParams.get('email')?.trim() ?? '';

// Already signed in? Skip the form.
//
// Uses the same resolver as the guard, on purpose: if this page accepted a
// session the middleware rejects (a deleted user, a rotated password), the two
// would bounce the browser between /admin and /admin/entra forever.
if (configured && (await resolveSession(Astro.cookies, SESSION_SECRET!, users))) {
  return Astro.redirect('/admin');
}

const queryError = Astro.url.searchParams.get('errore');
// `hasOwnProperty`, not `in`: every object literal inherits `constructor`,
// `valueOf`, `toString` and friends, so `?errore=valueOf` would pass an `in`
// check and then render a function into the error box.
if (queryError && Object.prototype.hasOwnProperty.call(MESSAGES, queryError)) {
  error = queryError as MessageKey;
}

if (Astro.request.method === 'POST') {
  if (!configured) {
    error = 'configurazione';
  } else {
    /*
     * Throttle FIRST — before the body is parsed and before any crypto.
     *
     * The old order read a KV counter, then parsed the body, then ran PBKDF2.
     * That meant every unauthenticated POST cost a KV write plus ~3.7 ms of
     * derive whether or not the caller was already over the limit. Checking
     * first makes a throttled attempt cost effectively nothing, which is the
     * whole point on a Worker that also serves the public site.
     */
    const limit = await checkLoginRate(getLoginLimiter(), ip);
    const declared = Number(Astro.request.headers.get('content-length') ?? '0');

    if (!limit.allowed) {
      error = 'bloccato';
    } else if (declared > MAX_LOGIN_BODY) {
      // Not a message he can ever see from the real form: the form is tiny.
      error = 'credenziali';
    } else {
      // A non-form Content-Type makes formData() throw. Unauthenticated callers
      // choose that header, so an uncaught throw here is a zero-byte 500 anyone
      // can trigger on the login page.
      let form: FormData | null = null;
      try {
        form = await Astro.request.formData();
      } catch {
        form = null;
      }

      email = String(form?.get('email') ?? '');
      const password = String(form?.get('password') ?? '');
      const turnstileToken = form?.get('cf-turnstile-response');

      if (!form) {
        error = 'credenziali';
      } else {
        const bot = await verifyTurnstile(
          TURNSTILE_SECRET_KEY,
          typeof turnstileToken === 'string' ? turnstileToken : undefined,
          ip,
        );

        if (!bot.ok) {
          // Only an actual rejection is evidence of a bot. A missing token means
          // the widget never rendered (a misconfigured deploy), and 'unreachable'
          // means Cloudflare was unreachable from Rio — neither is Francesco's
          // fault, and neither should count against him.
          error = bot.reason === 'rejected' ? 'robot' : 'verifica';
        } else {
          const user = await authenticate(users, email, password);
          if (user) {
            await issueSession(Astro.cookies, user, SESSION_SECRET!, isSecureRequest(Astro));
            return Astro.redirect('/admin');
          }
          error = 'credenziali';
        }
      }
    }
  }
}
---

<AdminBase title="Entra" bare>
  <div class="mx-auto flex min-h-[70dvh] max-w-sm flex-col justify-center">
    <p class="eyebrow text-ouro">Vidapiena</p>
    <h1 class="mt-3 font-display text-3xl font-bold">Il tuo pannello</h1>
    <p class="mt-3 text-paper/60">Entra per scrivere e pubblicare gli articoli del blog.</p>

    {/*
      If he opens the link from inside WhatsApp, iOS renders it in WhatsApp's own
      WebView, which keeps a separate cookie jar and cannot save a password to the
      keychain. He would log in successfully and then appear logged out forever in
      Safari — the exact opposite of "stay signed in". We cannot leave that
      WebView programmatically, so tell him plainly. Hidden by default and shown
      only on detection, so the common case sees nothing.
    */}
    <p
      id="avviso-browser"
      hidden
      class="mt-6 rounded-lg border border-ouro/40 bg-ouro/10 px-4 py-3 text-sm text-paper"
    >
      Stai aprendo la pagina dentro un’altra app. Tocca i tre puntini in alto e scegli
      <strong>«Apri in Safari»</strong>: così resti collegato e il telefono può salvare la
      password.
    </p>

    {
      error && (
        <p
          role="alert"
          class="mt-6 rounded-lg border border-rosso/40 bg-rosso/10 px-4 py-3 text-sm text-paper"
        >
          {MESSAGES[error]}
        </p>
      )
    }

    <form method="POST" class="mt-8 flex flex-col gap-5">
      <label class="flex flex-col gap-2">
        <span class="eyebrow text-paper/50">Email</span>
        <input
          type="email"
          name="email"
          value={email}
          required
          autocomplete="username"
          inputmode="email"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          class="w-full rounded-lg border border-paper/20 bg-paper/5 px-4 py-3 text-base text-paper placeholder:text-paper/30"
        />
      </label>

      <label class="flex flex-col gap-2">
        <span class="eyebrow text-paper/50">Password</span>
        <input
          type="password"
          name="password"
          required
          autocomplete="current-password"
          class="w-full rounded-lg border border-paper/20 bg-paper/5 px-4 py-3 text-base text-paper"
        />
      </label>

      {
        turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />
        )
      }

      <button type="submit" class="btn btn-primary mt-2 w-full justify-center">Entra</button>
    </form>

    {/*
      A real link, not prose. This is the one dead end in the whole design — there
      is no self-service reset because his mailbox is full — so the escape hatch has
      to be one tap, with the subject already written.
    */}
    <p class="mt-8 text-sm text-paper/40">
      Password dimenticata?{' '}
      <a
        href="mailto:leonardo.rodo@outlook.it?subject=Vidapiena%20—%20non%20riesco%20a%20entrare%20nel%20pannello"
        class="link-sweep text-ouro"
      >
        Scrivi a Leo
      </a>{' '}
      — per sicurezza non si può recuperare da qui.
    </p>
  </div>

  <script is:inline>
    // UA sniffing is the only signal available for this: an in-app WebView is not
    // otherwise distinguishable from Safari, and getting it wrong only means an
    // advisory banner is or isn't shown.
    (function () {
      var ua = navigator.userAgent || '';
      var inApp = /\b(WhatsApp|Instagram|FBAN|FBAV|FB_IAB|Line|Twitter)\b/i.test(ua);
      if (inApp) {
        var el = document.getElementById('avviso-browser');
        if (el) el.hidden = false;
      }
    })();
  </script>

  {
    turnstileSiteKey && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      />
    )
  }
</AdminBase>
