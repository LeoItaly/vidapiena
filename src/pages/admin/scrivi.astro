---
/**
 * Write or edit one article.
 *
 * ⚠️ `prerender = false` is load-bearing. `output` is `'static'`, so a page
 * without this line is prerendered into dist/client and served by Cloudflare's
 * asset router — in FRONT of the Worker, so src/middleware.ts never runs and the
 * page is readable by anyone. `npm run build` fails if it is ever forgotten
 * (scripts/verify-build.mjs).
 */
export const prerender = false;

import AdminBase from '../../layouts/AdminBase.astro';
import { getKV } from '../../lib/admin/runtime';
import {
  DRAFT_ID,
  getDraft,
  getPhotoIndex,
  newDraftId,
  ownership,
  type DraftDoc,
} from '../../lib/admin/draft-store';
import { getPhoto } from '../../lib/admin/photo-store';
import { BLOCK_LABELS } from '../../lib/admin/blocks';
import { TOURS } from '../../data/tours';
import { it } from '../../i18n/it';
// The live preview ("Vedi com’è") renders the article body with the same styles
// as the published page — one shared stylesheet, so it cannot lie.
import '../../styles/article-body.css';

const admin = Astro.locals.admin;
const kv = getKV();

const richiesta = Astro.url.searchParams.get('bozza') ?? '';
const draftId = DRAFT_ID.test(richiesta) ? richiesta : newDraftId();

const oggi = new Date().toISOString().slice(0, 10);
const vuoto: DraftDoc = {
  title: '',
  description: '',
  date: oggi,
  coverPhotoId: '',
  blocks: [{ k: 'p', testo: '' }],
  owner: admin?.email ?? '',
  updatedAt: 0,
};

let doc = vuoto;
let foto: { id: string; width: number; height: number; alt: string; caption: string }[] = [];
let negato = false;

if (kv && DRAFT_ID.test(richiesta)) {
  const salvata = await getDraft(kv, richiesta);
  if (salvata) {
    if (ownership(salvata.owner, admin?.email ?? '') === 'altrui') negato = true;
    else doc = salvata;
  }
  const index = await getPhotoIndex(kv, richiesta);
  if (index && ownership(index.owner, admin?.email ?? '') !== 'altrui') {
    for (const id of index.ids) {
      const p = await getPhoto(kv, richiesta, id);
      if (p) foto.push({ id, width: p.width, height: p.height, alt: p.alt, caption: p.caption });
    }
  }
}

// Italian names only: the picker is a list he reads. The link it emits is
// locale-invariant (`../../tour/<slug>/`), so the same relative URL resolves
// correctly from both /blog/ and /en/blog/ — which is why the five hand-written
// articles use that form too.
const tours = TOURS.map((t) => ({ slug: t.slug, nome: it.tours.items[t.id].name }));

const TIPI: { k: keyof typeof BLOCK_LABELS; aiuto: string }[] = [
  { k: 'p', aiuto: 'Il testo normale dell’articolo' },
  { k: 'h2', aiuto: 'Divide l’articolo in parti' },
  { k: 'h3', aiuto: 'Una sotto-parte' },
  { k: 'ul', aiuto: 'Un elenco puntato' },
  { k: 'ol', aiuto: 'Un elenco numerato' },
  { k: 'quote', aiuto: 'Una frase messa in evidenza' },
  // Not "una delle foto che hai caricato" any more: the block takes a photo off
  // the phone itself, so the button must not describe a library he may not have.
  { k: 'foto', aiuto: 'Una foto: la carichi qui dal telefono' },
];
---

<AdminBase title={doc.title || 'Nuovo articolo'} user={admin}>
  {
    negato ? (
      <div class="rounded-lg border border-rosso/40 bg-rosso/10 px-4 py-3 text-paper">
        <p>Questa bozza è di un altro account.</p>
        <p class="mt-3">
          <a href="/admin" class="btn btn-primary">Torna ai tuoi articoli</a>
        </p>
      </div>
    ) : (
      <div data-editor data-bozza={draftId}>
        {/* The way back. Without it the editor is a page you can only leave through
            the small link in the header — and this client did not find it. The
            script routes it through the unsaved-changes prompt. */}
        <a
          href="/admin"
          data-nav="indietro"
          class="link-sweep eyebrow inline-flex items-center gap-1 text-paper/50"
        >
          ‹ I tuoi articoli
        </a>
        <div class="mt-3 flex flex-wrap items-baseline justify-between gap-3">
          <p class="eyebrow text-ouro">{doc.publishedSlug ? 'Modifica' : 'Nuovo articolo'}</p>
          <p data-stato class="eyebrow text-paper/40" role="status" aria-live="polite" />
        </div>

        {/* Scrivi ↔ Vedi: the same article, being written or shown as it will look
            online. The live preview is client-rendered, so switching costs nothing
            and never touches the save budget. */}
        <div
          class="mt-4 inline-flex rounded-lg border border-paper/15 p-1"
          role="tablist"
          aria-label="Scrivi o guarda l’anteprima"
        >
          <button
            type="button"
            data-modo="scrivi"
            role="tab"
            aria-selected="true"
            class="rounded-md px-3 py-1.5 text-sm font-medium bg-ouro text-ink"
          >
            Scrivi
          </button>
          <button
            type="button"
            data-modo="vedi"
            role="tab"
            aria-selected="false"
            class="rounded-md px-3 py-1.5 text-sm font-medium text-paper/60"
          >
            Vedi com’è
          </button>
        </div>

        <div data-pannello="scrivi">
        <label class="mt-6 flex flex-col gap-1">
          <span class="eyebrow text-paper/50">Titolo</span>
          <input
            data-titolo
            type="text"
            class="w-full rounded-lg border border-paper/20 bg-paper/5 px-4 py-3 font-display text-xl font-bold text-paper"
            placeholder="Di cosa parla questo articolo?"
          />
        </label>
        {doc.publishedSlug && (
          <p class="mt-1 text-xs text-paper/40">
            L’indirizzo dell’articolo resta <code>/blog/{doc.publishedSlug}/</code> anche se cambi il
            titolo, così i link che hai già mandato continuano a funzionare.
          </p>
        )}

        <label class="mt-5 flex flex-col gap-1">
          <span class="eyebrow text-paper/50">Riassunto</span>
          <textarea
            data-riassunto
            rows="2"
            class="w-full rounded-lg border border-paper/20 bg-paper/5 px-4 py-3 text-base text-paper"
            placeholder="Due righe: è quello che si legge su Google e nella lista del blog."
          />
        </label>
        {/* One-tap AI help: reads the article and proposes a Riassunto he can edit.
            Free (Workers AI, already used for the translation). Never overwrites
            silently — it fills the field for him to accept or change. */}
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-suggerisci-riassunto
            class="rounded-lg border border-ouro/40 px-3 py-1.5 text-sm text-ouro"
          >
            ✨ Suggerisci un riassunto
          </button>
          <span data-suggerisci-stato class="text-xs text-paper/50" role="status" aria-live="polite"
          ></span>
        </div>

        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <label class="flex flex-col gap-1">
            <span class="eyebrow text-paper/50">Data</span>
            <input
              data-data
              type="date"
              class="w-full rounded-lg border border-paper/20 bg-paper/5 px-4 py-3 text-base text-paper"
            />
          </label>
          <label class="flex flex-col gap-1">
            <span class="eyebrow text-paper/50">Foto di copertina</span>
            <select
              data-copertina
              class="w-full rounded-lg border border-paper/20 bg-paper/5 px-4 py-3 text-base text-paper"
            >
              <option value="">Nessuna</option>
              {/* A cover carried over from a published article isn't a staged
                  upload, so it needs its own option or it would be lost on save. */}
              {doc.coverPhotoId?.startsWith('pub:') && (
                <option value={doc.coverPhotoId}>Foto attuale (già online)</option>
              )}
              {foto.map((f, i) => (
                <option value={f.id}>{f.alt || `Foto ${i + 1}`}</option>
              ))}
            </select>
          </label>
        </div>
        {/* Upload a cover straight from the phone. Outside the <label> above on
            purpose: a file input nested inside a label that already wraps the
            select is invalid, and Safari picks one of the two controls to open. */}
        <div data-copertina-carica class="mt-3 max-w-sm"></div>
        {/* The real 16:9 crop, because his photos are mostly vertical. */}
        <div data-copertina-anteprima class="mt-3 max-w-sm" />

        {/* The one editorial choice that wires the article into the rest of the
            site: which tour it is about. Set it, and the article appears on that
            tour's page and links back to it — with nothing more to do. Left on
            "Nessuno in particolare" for a general piece. */}
        <label class="mt-5 flex flex-col gap-1">
          <span class="eyebrow text-paper/50">Di quale tour parla?</span>
          <select
            data-tour-relativo
            class="w-full rounded-lg border border-paper/20 bg-paper/5 px-4 py-3 text-base text-paper"
          >
            <option value="">Nessuno in particolare</option>
            {
              TOURS.map((tr) => (
                <option value={tr.id} selected={doc.relatedTour === tr.id}>
                  {it.tours.items[tr.id].name}
                </option>
              ))
            }
          </select>
          <span class="mt-1 text-xs text-paper/40">
            L’articolo comparirà nella pagina di quel tour e lo collegherà. Lascia
            «Nessuno» se è un racconto generale.
          </span>
        </label>

        {/* Live "ready for Google" coaching. Filled and kept current by the editor
            script (seo-checklist.ts) as he types — advice only, never a block. */}
        <div
          data-seo-checklist
          class="mt-6 rounded-lg border border-paper/15 bg-paper/5 p-4"
          role="status"
          aria-live="polite"
        >
        </div>

        <h2 class="mt-10 font-display text-xl font-bold">L’articolo</h2>
        <ol data-blocchi class="mt-3 flex flex-col gap-3" />

        <div class="mt-5">
          <p class="eyebrow text-paper/50">Aggiungi</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {TIPI.map((t) => (
              <button
                type="button"
                data-aggiungi={t.k}
                title={t.aiuto}
                class="rounded-lg border border-paper/20 px-3 py-2 text-sm text-paper/80"
              >
                {BLOCK_LABELS[t.k]}
              </button>
            ))}
          </div>
        </div>
        </div>

        {/* The live preview. Rendered on paper with the real article styles, so
            what he sees here is what the page will be. Hidden until he taps
            "Vedi com’è"; the editor script fills it in. */}
        <section data-pannello="vedi" hidden class="mt-6">
          <p class="max-w-prose text-sm text-paper/50">
            Così apparirà online. Non è ancora pubblicato: lo vedi solo tu.
          </p>
          <article class="mt-4 rounded-lg bg-paper px-5 py-8 text-ink md:px-10 md:py-12">
            <p data-viva-data class="eyebrow text-ink-soft/60"></p>
            <h1 data-viva-titolo class="mt-2 font-display text-3xl font-bold md:text-4xl"></h1>
            <div data-viva-copertina></div>
            <div data-viva-corpo class="article-body mt-8 max-w-prose"></div>
          </article>
        </section>

        {/*
          Sticky, because on a phone the save button is otherwise a long scroll
          away from wherever he is typing — and this is a client who leaves
          mid-sentence to start a tour.
        */}
        <div
          class="sticky bottom-0 -mx-5 mt-10 flex flex-wrap gap-3 border-t border-paper/10 bg-ink/95 px-5 py-4 backdrop-blur md:-mx-10 md:px-10"
        >
          <button type="button" data-salva class="btn btn-primary">Salva</button>
          <a href={`/admin/anteprima?bozza=${draftId}`} data-nav="avanti" class="btn">Anteprima</a>
          <a href={`/admin/pubblica?bozza=${draftId}`} data-nav="avanti" class="btn">
            {doc.publishedSlug ? 'Aggiorna' : 'Pubblica'}
          </a>
          <a href="/admin/aiuto" data-nav="indietro" class="eyebrow self-center text-paper/40">
            Come si fa?
          </a>
        </div>
      </div>
    )
  }

  {/*
    The draft is handed to the client as JSON in a data island rather than via
    `define:vars`, because the module script below is bundled and cannot see
    server scope. `set:html` with JSON.stringify is safe here: the value is
    serialised, not interpolated into markup — and every string in it (title,
    body, alt text) is attacker-influenced only by the two people who can log in.
  */}
  <script
    is:inline
    type="application/json"
    id="dati-bozza"
    set:html={JSON.stringify({ draftId, doc, foto, tours })}
  />

  <script>
    import { mountEditor, recuperaLocale } from '../../scripts/admin-editor';

    // Cast, not a generic: worker-configuration.d.ts declares a global `Element`
    // for HTMLRewriter, which shadows the DOM one and breaks querySelector's
    // `extends Element` constraint.
    const root = document.querySelector('[data-editor]') as HTMLElement | null;
    const isola = document.getElementById('dati-bozza');

    if (root && isola?.textContent) {
      const dati = JSON.parse(isola.textContent) as Omit<
        Parameters<typeof mountEditor>[0],
        'root' | 'doc'
      > & { doc: Parameters<typeof mountEditor>[0]['doc'] };

      // localStorage wins when it is newer: KV holds what was pushed up to a
      // minute ago, localStorage holds every keystroke since. This is what makes
      // "Safari killed the backgrounded tab" a non-event.
      mountEditor({
        root,
        draftId: dati.draftId,
        doc: recuperaLocale(dati.draftId, dati.doc),
        foto: dati.foto,
        tours: dati.tours,
      });
    }
  </script>
</AdminBase>
