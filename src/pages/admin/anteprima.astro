---
/**
 * How the article will look once it is online.
 *
 * ⚠️ `prerender = false` is load-bearing — see the note in scrivi.astro.
 */
export const prerender = false;

import AdminBase from '../../layouts/AdminBase.astro';
import { getKV } from '../../lib/admin/runtime';
import { DRAFT_ID, getDraft, getPhotoIndex, ownership } from '../../lib/admin/draft-store';
import { blocksToPreviewHtml } from '../../lib/admin/preview-html';
import { plainText } from '../../lib/admin/blocks';
import { slugForTitle } from '../../lib/admin/slug';

const admin = Astro.locals.admin;
const kv = getKV();
const draftId = Astro.url.searchParams.get('bozza') ?? '';

let doc = null;
let negato = false;
let fotoIds: string[] = [];

if (kv && DRAFT_ID.test(draftId)) {
  const salvata = await getDraft(kv, draftId);
  if (salvata) {
    if (ownership(salvata.owner, admin?.email ?? '') === 'altrui') negato = true;
    else doc = salvata;
  }
  const index = await getPhotoIndex(kv, draftId);
  if (index && ownership(index.owner, admin?.email ?? '') !== 'altrui') fotoIds = index.ids;
}

const src = (fotoId: string) =>
  fotoIds.includes(fotoId)
    ? `/admin/api/foto?bozza=${encodeURIComponent(draftId)}&foto=${encodeURIComponent(fotoId)}`
    : null;

const corpo = doc ? blocksToPreviewHtml(doc.blocks, src) : '';
const copertina = doc?.coverPhotoId ? src(doc.coverPhotoId) : null;
const parole = doc ? plainText(doc.blocks).split(/\s+/).filter(Boolean).length : 0;
const slug = doc ? (doc.publishedSlug ?? slugForTitle(doc.title, new Date(doc.date))) : '';

const dataIt = doc
  ? new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }).format(
      new Date(doc.date),
    )
  : '';
---

<AdminBase title="Anteprima" user={admin}>
  {
    negato || !doc ? (
      <div class="rounded-lg border border-rosso/40 bg-rosso/10 px-4 py-3 text-paper">
        <p>{negato ? 'Questa bozza è di un altro account.' : 'Questa bozza non esiste più.'}</p>
        <p class="mt-3">
          <a href="/admin" class="btn btn-primary">Torna ai tuoi articoli</a>
        </p>
      </div>
    ) : (
      <>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <p class="eyebrow text-ouro">Anteprima</p>
          <p class="eyebrow text-paper/40">
            {parole} parole · indirizzo <code>/blog/{slug}/</code>
          </p>
        </div>
        <p class="mt-2 max-w-prose text-sm text-paper/50">
          Così apparirà online. Non è ancora pubblicato: nessuno può vederlo tranne te.
        </p>

        {/*
          Rendered on `paper` with the real article styles, so the preview is the
          published typography rather than a dark-mode approximation of it.
        */}
        <article class="anteprima mt-8 rounded-lg bg-paper px-5 py-8 text-ink md:px-10 md:py-12">
          <p class="eyebrow text-ink-soft/60">{dataIt}</p>
          <h1 class="mt-2 font-display text-3xl font-bold md:text-4xl">
            {doc.title || 'Senza titolo'}
          </h1>
          {copertina && (
            <img
              src={copertina}
              alt={doc.title}
              class="mt-6 aspect-[16/9] w-full rounded-lg object-cover"
            />
          )}
          <div class="article-body mt-8 max-w-prose" set:html={corpo} />
        </article>

        <div class="sticky bottom-0 -mx-5 mt-8 flex flex-wrap gap-3 border-t border-paper/10 bg-ink/95 px-5 py-4 backdrop-blur md:-mx-10 md:px-10">
          <a href={`/admin/scrivi?bozza=${draftId}`} class="btn btn-primary">Torna a scrivere</a>
          <a href="/admin" class="btn">I tuoi articoli</a>
        </div>
      </>
    )
  }
</AdminBase>

<style>
  /*
    Deliberately the same rules as BlogPostPage.astro's `.article-body`.
    They are duplicated rather than imported because Astro scopes component
    styles and there is no shared stylesheet for them — if these two ever drift,
    the preview stops being a preview. The blocksToPreviewHtml ↔ blocksToMarkdown
    equivalence is what the build test pins; this block is what makes it *look*
    the same.
  */
  .anteprima :global(.article-body p) {
    margin-top: 1.1em;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }
  .anteprima :global(.article-body h2) {
    margin-top: 2em;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
  }
  .anteprima :global(.article-body h3) {
    margin-top: 1.6em;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .anteprima :global(.article-body ul),
  .anteprima :global(.article-body ol) {
    margin-top: 1.1em;
    padding-left: 1.2em;
    list-style: disc;
    color: var(--color-ink-soft);
  }
  .anteprima :global(.article-body ol) {
    list-style: decimal;
  }
  .anteprima :global(.article-body li) {
    margin-top: 0.4em;
    line-height: 1.7;
  }
  .anteprima :global(.article-body a) {
    color: var(--color-verde);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .anteprima :global(.article-body img) {
    margin-top: 1.5em;
    border-radius: 0.5rem;
  }
  .anteprima :global(.article-body blockquote) {
    margin-top: 1.5em;
    border-left: 3px solid var(--color-ouro);
    padding-left: 1em;
    font-style: italic;
  }
  .anteprima :global(.article-body figure) {
    margin-top: 1.5em;
  }
  .anteprima :global(.article-body figure p),
  .anteprima :global(.article-body figure img) {
    margin-top: 0;
  }
  .anteprima :global(.article-body figcaption) {
    margin-top: 0.6em;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-ink-soft) 65%, transparent);
  }
</style>
