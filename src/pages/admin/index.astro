---
/**
 * Back-office home.
 *
 * Reachable only with a valid session — src/middleware.ts redirects to
 * /admin/entra otherwise, so this page never has to check.
 *
 * Stage 2 of the build: the shell and the login are real, the article list and
 * editor are not yet. What is here is honest about that rather than showing dead
 * buttons — Francesco tapping something that does nothing costs more trust than
 * an empty state that says "coming".
 */
export const prerender = false;

import { getCollection } from 'astro:content';
import AdminBase from '../../layouts/AdminBase.astro';

const admin = Astro.locals.admin;

// Read-only for now, straight from the same content collection the site renders.
const posts = (await getCollection('blog', ({ data }) => data.locale === 'it')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const dateFmt = new Intl.DateTimeFormat('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<AdminBase title="Gestione" user={admin}>
  <p class="eyebrow text-ouro">Ciao {admin?.name ?? ''}</p>
  <h1 class="mt-3 font-display text-3xl font-bold md:text-4xl">I tuoi articoli</h1>
  <p class="mt-3 max-w-prose text-paper/60">
    Qui trovi tutto quello che hai pubblicato. Presto potrai scriverne di nuovi direttamente da
    questa pagina.
  </p>

  <ul class="mt-10 flex flex-col gap-3">
    {
      posts.map((post) => (
        <li class="rounded-lg border border-paper/10 bg-paper/5 p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="font-display text-lg font-bold">{post.data.title}</h2>
            <span class="eyebrow shrink-0 tabular-nums text-paper/40">
              {dateFmt.format(post.data.date)}
            </span>
          </div>
          <p class="mt-2 line-clamp-2 text-sm text-paper/60">{post.data.description}</p>
          <p class="eyebrow mt-3 text-paper/40">
            {post.data.draft ? 'Bozza' : 'Pubblicato'}
          </p>
        </li>
      ))
    }
  </ul>

  <p class="mt-10 rounded-lg border border-ouro/30 bg-ouro/5 px-4 py-3 text-sm text-paper/70">
    L’editor per scrivere e pubblicare è in costruzione. Per ora questa pagina è solo in lettura.
  </p>
</AdminBase>
