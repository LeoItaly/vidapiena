---
import OtaLogo from './OtaLogo.astro';
import { PLATFORMS } from '../lib/platforms';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

/*
 * The global "Vidapiena is on…" strip. No panel: the marks drift straight on
 * the ink band, tinted to one soft off-white so four differently-coloured
 * brand logos read as a single clean row (client decision 31/07 — the cream
 * panel and per-mark colours were dropped). The tint is a whitening filter,
 * not a recolour of the source art (see the <style> note): Airbnb, GetYourGuide
 * and Civitatis all publish official reversed/white variants, and Viator — a
 * teal raster with no white master — is whitened by the same filter so the
 * strip stays uniform on the dark background.
 * Deliberately UNLINKED (OTA-LINKS.md rule): per-tour deep links belong on the
 * cards and tour pages; a global badge pointing at one arbitrary tour's listing
 * would mislead.
 */
const SIZES: Record<string, string> = {
  viator: 'h-6 md:h-7',
  getyourguide: 'h-7 md:h-8',
  airbnb: 'h-7 md:h-8',
  civitatis: 'h-5 md:h-6',
};
const badges = PLATFORMS.map((p) => ({ key: p.key, name: p.name, h: SIZES[p.key] }));
---

{/* One continuous ink region with Footer/FinalCta — no seams, no panel. */}
<section class="bg-ink text-paper py-16 md:py-20">
  <p class="eyebrow mx-auto max-w-5xl px-5 text-center text-paper/55" data-scramble>
    {dict.badges.heading}
  </p>

  {/* Full-bleed drift. Default (no JS / reduced motion): the same list is a
      centred, wrapping row. With motion: it becomes a slow endless drift that
      quickens as you scroll past. Four server-rendered copies (the row is
      short) keep the CSS -50% base loop seamless before the JS engine adopts
      it; duplicates are display:none on the static path. */}
  <div class="badge-row mt-9" data-marquee-row data-dir="-1" data-speed="38" style="--mq-dur: 90s">
    <div class="badge-track" data-marquee-track>
      {
        [0, 1, 2, 3].map((copy) => (
          <ul
            class:list={['badge-seq', copy > 0 && 'mq-dupe']}
            data-marquee-seq={copy === 0 ? true : undefined}
            aria-hidden={copy > 0 ? 'true' : undefined}
          >
            {badges.map((b) => (
              <li class="flex items-center">
                <OtaLogo platform={b.key} name={b.name} class={b.h} />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Uniform off-white tint for every mark — the inline SVGs (Airbnb, GYG,
     Civitatis) and the transparent Viator raster alike. brightness(0) collapses
     each mark to solid black while preserving its alpha; invert(1) lifts that
     to white. One filter, identical result on vector fills and PNG pixels, so
     the four brands read as one strip on the ink band. Slightly dimmed so it
     sits back like a partner row rather than shouting. */
  .badge-row :global(.ota-logo),
  .badge-row :global(img) {
    filter: brightness(0) invert(1);
    opacity: 0.82;
  }

  /* ---- Static path (default) — the centred, wrapping row ----------------- */
  .badge-seq {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 3rem;
    /* Keep wrapped marks off the viewport edge on narrow screens. */
    padding-inline: 1.5rem;
  }

  /* ---- Motion path — endless drift -------------------------------------- */
  :global(.motion-ok) .badge-row {
    overflow: hidden;
    /* Edges dissolve instead of clipping a logo in half. */
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 8%,
      #000 92%,
      transparent 100%
    );
  }
  :global(.motion-ok) .badge-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  :global(.motion-ok) .badge-seq {
    flex-wrap: nowrap;
    justify-content: flex-start;
    /* Trailing gap inside the sequence — its measured width is the exact wrap
       distance, so the loop has no seam. Explicit 0 on the left overrides the
       static inline padding, keeping that measurement accurate. */
    gap: 3rem;
    padding: 0 3rem 0 0;
  }
</style>
