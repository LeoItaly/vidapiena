---
/**
 * /prenota — the booking page: one tour picker and ONE very large Bókun
 * calendar, nothing else.
 *
 * Bókun has no calendar that spans several products (each tour is its own
 * `experience-calendar/bokunId`), so the four tiles re-point a single frame
 * instead of stacking four iframes. src/scripts/bokun.ts owns the switch
 * (data-bokun-pick) and keeps it deep-linkable as ?tour=id.
 *
 * "Very large" is a zoom, not a wide frame: the widget caps its own content at
 * 496px inside the iframe (read live 26/09/2026), so a wide iframe is just a
 * narrow column in white. styles/bokun.css lays the widget out at 32rem and
 * zooms it up from the md breakpoint (data-stage).
 *
 * Unlike the tour-page rail, the frame mounts at EVERY width
 * (data-bokun-always): on this page the calendar is the page. The checkout
 * still opens in the shared BokunDialog below — the widget asks the parent for
 * it (OpenModalRequest), so the dialog must be on the page.
 */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Footer from '../Footer.astro';
import JsonLdScript from '../JsonLdScript.astro';
import BokunDialog from '../BokunDialog.astro';
import Price from '../Price.astro';
import { SITE } from '../../data/site';
import { TOURS } from '../../data/tours';
import { bokunCalendarSrc } from '../../lib/bokun';
import { getPhoto } from '../../lib/photos';
import { t, pagePath, localeHref, absoluteUrl, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const path = 'prenota/';

const picks = TOURS.map((tour) => {
  const name = dict.tours.items[tour.id].name;
  return {
    tour,
    name,
    photo: getPhoto(tour.image),
    src: bokunCalendarSrc(tour.bokunId, locale),
    title: dict.booking.calendarFrameTitle(name),
    href: pagePath(locale, `tour/${tour.slug}/`),
    wa: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(dict.booking.waPrefillTour(name))}`,
  };
});
const first = picks[0];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: dict.bookPage.metaTitle,
      description: dict.bookPage.metaDescription,
      url: absoluteUrl(pagePath(locale, path)),
      inLanguage: locale,
      about: { '@id': `${absoluteUrl(localeHref('it'))}#operator` },
    },
  ],
};
---

<Base locale={locale} path={path} title={dict.bookPage.metaTitle} description={dict.bookPage.metaDescription}>
  <JsonLdScript slot="head" graph={graph} />
  <PageHero kicker={dict.bookPage.kicker} heading={dict.bookPage.heading} sub={dict.booking.calendarLead} />

  <main id="main" class="bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-5 pb-20 md:px-10 md:pb-28">
      <p id="book-picker-label" class="eyebrow text-paper/55">{dict.bookPage.pickerLabel}</p>
      <div
        class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4"
        role="group"
        aria-labelledby="book-picker-label"
        data-bokun-picker
        data-stagger
      >
        {
          picks.map((p, i) => (
            <button
              type="button"
              class="group relative flex flex-col overflow-hidden rounded-xl border border-paper/15 bg-paper/5 text-left transition-[border-color,background-color] duration-300 hover:border-paper/40 aria-pressed:border-ouro aria-pressed:bg-paper/10"
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-bokun-pick={p.tour.id}
              data-bokun-src={p.src}
              data-bokun-name={p.name}
              data-bokun-title={p.title}
              data-bokun-href={p.href}
              data-bokun-wa={p.wa}
            >
              {p.photo ? (
                <Picture
                  src={p.photo}
                  formats={['avif', 'webp']}
                  widths={[320, 640]}
                  sizes="(min-width: 768px) 16rem, 50vw"
                  alt=""
                  class="aspect-[16/10] w-full object-cover opacity-55 grayscale-[35%] transition-[opacity,filter] duration-500 group-hover:opacity-85 group-aria-pressed:opacity-100 group-aria-pressed:grayscale-0"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div
                  class="aspect-[16/10] w-full"
                  style="background: linear-gradient(145deg, var(--color-azzurro) 0%, var(--color-notturno) 100%)"
                  role="presentation"
                />
              )}
              {/* The ticked state, in ouro — decorative; aria-pressed carries it. */}
              <span
                class="absolute top-2.5 right-2.5 hidden size-7 place-content-center rounded-full bg-ouro text-ink shadow-lg group-aria-pressed:grid"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
              </span>
              <span class="flex grow flex-col p-3 md:p-4">
                <span class="font-display text-base leading-tight font-bold md:text-lg">{p.name}</span>
                <span class="eyebrow mt-1.5 text-paper/55">{dict.tours.hours(p.tour.durationHours)}</span>
                <span class="mt-auto pt-3 font-mono text-sm">
                  {p.tour.priceIsFrom && <span class="text-paper/60">{dict.tours.from} </span>}
                  <Price class="font-medium text-ouro" brl={p.tour.priceBRL} eur={p.tour.priceEUR} />
                  <span class="text-paper/60"> {dict.tours.perPerson}</span>
                </span>
              </span>
            </button>
          ))
        }
      </div>

      <section class="mx-auto mt-12 md:mt-16 md:w-[40rem] lg:w-[48rem]" aria-labelledby="book-stage-name">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
          <div class="min-w-0">
            <p class="eyebrow text-paper/55">{dict.booking.calendarEyebrow}</p>
            <h2
              id="book-stage-name"
              class="font-display mt-1.5 text-2xl leading-tight font-bold md:text-4xl"
              data-bokun-stage-name
            >
              {first.name}
            </h2>
          </div>
          <a href={first.href} class="link-sweep eyebrow text-ouro" data-bokun-stage-link>
            {dict.bookPage.detailLink} →
          </a>
        </div>

        <div
          class="vp-bokun-frame mt-5"
          data-stage
          data-bokun-inline
          data-bokun-always
          data-bokun-stage
          data-bokun-src={first.src}
          data-bokun-title={first.title}
          data-bokun-name={first.name}
        >
          <p class="vp-bokun-loading">{dict.booking.calendarLoading}</p>
        </div>

        <p class="mt-5 text-center text-sm leading-relaxed text-paper/65">{dict.booking.calendarNote}</p>
        <noscript>
          <p class="mt-3 text-center text-sm leading-relaxed text-paper/65">{dict.booking.calendarNoscript}</p>
        </noscript>
      </section>
    </div>
  </main>

  <BokunDialog locale={locale} />
  <Footer locale={locale} path={path} />
</Base>
