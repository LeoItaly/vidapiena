---
/**
 * OTA logo chips — UNLINKED proof only. The four marks say "Vidapiena is also on
 * these platforms" as trust / showcase; they are never booking links (client
 * decision 19 Aug 2026 — booking is direct via WhatsApp + Instagram so Francesco
 * keeps the full price with no commission, and the public site never advertises a
 * cheaper-direct link that Viator's lowest-price clause could act on).
 *
 * The link path was removed on purpose: "no OTA booking link on the marketing
 * site" is now a STRUCTURAL invariant — this component can no longer emit one.
 * Per-tour otaLinks stay in tours.ts only for JSON-LD `sameAs` (entity graph).
 * The marks render through OtaLogo.astro (three inlined SVGs + the Viator PNG).
 */
import OtaLogo from './OtaLogo.astro';
import { PLATFORMS } from '../lib/platforms';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<ul class={`flex flex-wrap items-center gap-2.5 ${className}`}>
  {
    PLATFORMS.map((p) => (
      <li>
        <span class="badge-chip">
          <OtaLogo platform={p.key} name={p.name} class="h-[1.15rem]" />
        </span>
      </li>
    ))
  }
</ul>

<style>
  /* Official marks live on a light neutral chip regardless of the band behind. */
  .badge-chip {
    display: flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    background: #fff;
    padding: 0.55rem 1.05rem;
  }
</style>
