---
/**
 * Bókun booking calendar — live availability on the tour page (05/09/2026).
 *
 * The booking channel is configured for PAY ON ARRIVAL (full payments and
 * deposits both off), so this is a REQUEST to book, not a checkout: the visitor
 * picks a date and sends the request, Francesco confirms and collects the money
 * directly. That keeps the 19/08 direct-booking decision intact — no card fees,
 * no OTA commission — while the calendar itself stays in sync with Viator (and,
 * once connected, GetYourGuide) through Bókun.
 *
 * The loader script must carry `is:inline`, or Astro tries to bundle a
 * cross-origin URL; same pattern as the Turnstile script in admin/entra.astro.
 * There is exactly one calendar per page, so loading it here is correct.
 *
 * The channel UUID is a public identifier — it ships in the page HTML of every
 * Bókun embed on the web and is not a secret.
 */
import type { Tour } from '../../data/tours';
import { t, type Locale } from '../../i18n';

interface Props {
  tour: Tour;
  locale: Locale;
}
const { tour, locale } = Astro.props;
const dict = t(locale);

const CHANNEL_UUID = 'd72739bc-dacd-4937-ba51-5d79fbfce9cb';
const widgetSrc = `https://widgets.bokun.io/online-sales/${CHANNEL_UUID}/experience-calendar/${tour.bokunId}`;
---

<div class="mt-10 rounded-2xl bg-paper p-4 text-ink md:p-6">
  <h3 class="font-display text-xl font-bold md:text-2xl">{dict.booking.calendarHeading}</h3>
  <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink/70">{dict.booking.calendarLead}</p>

  <div class="bokunWidget mt-6" data-src={widgetSrc}></div>

  <noscript>
    <p class="mt-4 text-sm text-ink/70">{dict.booking.calendarNoscript}</p>
  </noscript>
</div>

<script
  is:inline
  async
  src="https://widgets.bokun.io/assets/javascripts/apps/build/BokunWidgetsLoader.js?bookingChannelUUID=d72739bc-dacd-4937-ba51-5d79fbfce9cb"></script>
