---
/**
 * The tour deck — every original from the tour's media/ folder beyond the
 * hero, as a horizontal pile of cards flipped through like a deck.
 *
 * Dual-form (DESIGN.md §4), resilient like the marquees (§12): ONE markup
 * tree, two presentations.
 *   • Static / reduced-motion / no-JS: a horizontal scroll-snap strip — the
 *     cards sit side by side and you swipe or scroll sideways. Complete and
 *     useful with zero JavaScript, keyboard-reachable, captions visible.
 *   • JS-live: deck.ts adds `.is-live` to the section and restyles those exact
 *     nodes into an absolute pile — one photo on top of the next, a peek of
 *     the ones behind — that you drag/fling or step with the ‹ › buttons and
 *     the arrow keys. If that init ever throws, the section simply stays a
 *     strip; it is never a stranded pile with no engine.
 *
 * Tolerates missing keys (skipped, never a hole) and renders nothing when the
 * set is empty.
 */
import { Picture } from 'astro:assets';
import { getPhoto } from '../../lib/photos';

interface Props {
  keys: string[];
  heading: string;
  /** Used to build the photos' alt text and the card captions */
  tourName: string;
  /** dict.tourPage.galleryCount — the static total label ("12 fotografie") */
  countLabel: (n: number) => string;
  /** dict.tourPage.galleryPrev / galleryNext — nav button labels */
  prevLabel: string;
  nextLabel: string;
  /** dict.tourPage.galleryPosition — "Foto %c di %t", %c current / %t total */
  positionLabel: string;
  /** dict.tourPage.galleryHint — the drag affordance line */
  hint: string;
}
const { keys, heading, tourName, countLabel, prevLabel, nextLabel, positionLabel, hint } =
  Astro.props;
const photos = keys.map((key) => getPhoto(key)).filter((p) => p !== null);
const total = String(photos.length).padStart(2, '0');
const posLabel = (cur: number) =>
  positionLabel.replace('%c', String(cur)).replace('%t', String(photos.length));
---

{
  photos.length > 0 && (
    <section class="bg-paper text-ink" data-deck>
      <div class="mx-auto max-w-6xl px-5 pb-16 md:px-10 md:pb-24">
        <div class="deck-head flex items-baseline justify-between gap-6">
          <h2 class="eyebrow text-ink/55" data-scramble>
            {heading}
          </h2>
          <p class="font-mono text-xs text-ink/65">
            <span class="deck-total">{countLabel(photos.length)}</span>
            <span class="deck-live tabular-nums" aria-hidden="true">
              <span data-deck-current>01</span> / {total}
            </span>
          </p>
        </div>

        <div class="deck-stage mt-6" data-deck-stage>
          <ol
            class="deck-track list-none"
            role="list"
            tabindex="0"
            aria-label={heading}
          >
            {photos.map((photo, i) => (
              <li class="deck-item" data-deck-item>
                <figure class="deck-card">
                  <div class="deck-frame relative overflow-hidden rounded-lg">
                    <Picture
                      src={photo}
                      formats={['avif', 'webp']}
                      widths={[640, 1080, 1600]}
                      sizes="(min-width: 48rem) 44rem, 90vw"
                      alt={`${tourName} — ${heading} ${i + 1}`}
                      class="h-full w-full object-cover"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    <div class="deck-shade" aria-hidden="true" />
                  </div>
                  <figcaption class="deck-caption mt-2 flex items-baseline justify-between font-mono text-xs text-ink/65">
                    <span>{tourName}</span>
                    <span class="tabular-nums">
                      {String(i + 1).padStart(2, '0')} / {total}
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ol>

          <div class="deck-nav">
            <button type="button" class="deck-btn" data-deck-prev aria-label={prevLabel}>
              <span aria-hidden="true">‹</span>
            </button>
            <button type="button" class="deck-btn" data-deck-next aria-label={nextLabel}>
              <span aria-hidden="true">›</span>
            </button>
          </div>
        </div>

        <div class="deck-foot mt-4 flex items-center justify-between gap-6">
          <ol class="deck-dots" aria-hidden="true" role="list">
            {photos.map(() => (
              <li>
                <span class="deck-dot" data-deck-dot />
              </li>
            ))}
          </ol>
          <p class="deck-hint font-mono text-xs text-ink/50">{hint}</p>
        </div>

        <p
          class="sr-only"
          role="status"
          aria-live="polite"
          data-deck-status
          data-status-tpl={positionLabel}
        >
          {posLabel(1)}
        </p>
      </div>
    </section>
  )
}

<style>
  /* ------------------------------------------------------------------ *
   * Static form — a horizontal scroll-snap strip. Works with no JS:
   * swipe or scroll sideways, one card snaps into view at a time.
   * ------------------------------------------------------------------ */
  .deck-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
    scrollbar-color: color-mix(in srgb, var(--color-ink) 26%, var(--color-paper)) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .deck-item {
    flex: 0 0 min(86%, 40rem);
    scroll-snap-align: center;
  }
  .deck-frame {
    aspect-ratio: 4 / 3;
  }
  .deck-shade {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    opacity: 0;
    pointer-events: none;
  }

  /* Live counter, nav and dots are inert chrome until deck.ts wires them —
     hidden on the static path, revealed only once the pile is live. */
  .deck-live,
  .deck-nav,
  .deck-foot {
    display: none;
  }

  /* ------------------------------------------------------------------ *
   * Live form — the pile. deck.ts sets `.is-live` on the section after a
   * clean init; GSAP owns every card transform from here (transform +
   * opacity only, DESIGN.md §4 budget). CSS only lays out the coordinate
   * space; the depth cues are scripted.
   * ------------------------------------------------------------------ */
  [data-deck].is-live .deck-total {
    display: none;
  }
  [data-deck].is-live .deck-live {
    display: inline;
  }
  [data-deck].is-live .deck-nav,
  [data-deck].is-live .deck-foot {
    display: flex;
  }

  [data-deck].is-live .deck-stage {
    position: relative;
    overflow: clip; /* a flung card leaves cleanly; never `hidden` (§7) */
    touch-action: pan-y; /* horizontal drags belong to the deck, vertical to the page */
  }
  [data-deck].is-live .deck-track {
    display: block;
    position: relative;
    max-width: 44rem;
    margin-inline: auto;
    overflow: visible;
    padding: 0;
    /* height is set by deck.ts from the front card's width (4:3) */
  }
  [data-deck].is-live .deck-item {
    position: absolute;
    inset: 0;
    flex: none;
    /* horizontal drags drive the deck, vertical stays native page scroll */
    touch-action: pan-y;
    /* seeded hidden so the first paint can't flash an un-piled row; deck.ts
       overwrites this the instant it lays the pile out.
       No `will-change`: blanket promotion would GPU-composite every card in the
       stack (up to ~16 viewport-size layers); GSAP promotes only what it
       animates, for the short life of each transition. */
    opacity: 0;
  }
  [data-deck].is-live .deck-card {
    height: 100%;
  }
  [data-deck].is-live .deck-frame {
    aspect-ratio: auto;
    height: 100%;
    box-shadow: 0 18px 40px -20px color-mix(in srgb, var(--color-ink) 70%, transparent);
  }
  [data-deck].is-live .deck-caption {
    display: none;
  }
  [data-deck].is-live .deck-item.is-grabbable {
    cursor: grab;
  }
  [data-deck].is-live .deck-item.is-grabbing {
    cursor: grabbing;
  }

  /* Nav — a mono ‹ › pair pinned to the pile's lower-right corner. */
  [data-deck].is-live .deck-nav {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 50;
    gap: 0.5rem;
  }
  .deck-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);
    background: color-mix(in srgb, var(--color-paper) 82%, transparent);
    backdrop-filter: blur(6px);
    color: var(--color-ink);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.5rem;
    line-height: 1;
    transition:
      background 0.25s var(--ease-vp),
      transform 0.25s var(--ease-vp),
      color 0.25s var(--ease-vp);
  }
  .deck-btn > span {
    margin-top: -0.15em; /* optical centring of the chevron glyph */
  }
  .deck-btn:hover {
    background: var(--color-ouro);
    color: var(--color-ink);
  }
  .deck-btn:active {
    transform: scale(0.92);
  }

  /* Progress dots — decorative (the ‹ › buttons + live region carry the
     semantics); the active one stretches to a gold bar. */
  .deck-dots {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }
  .deck-dot {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 22%, transparent);
    cursor: pointer;
    transition:
      width 0.35s var(--ease-vp-out),
      background 0.35s var(--ease-vp-out);
  }
  .deck-dot[data-active] {
    width: 1.5rem;
    background: var(--color-ouro);
  }
  .deck-hint {
    flex: none;
  }

  @media (max-width: 30rem) {
    .deck-hint {
      display: none; /* the swipe is self-evident on touch; reclaim the row */
    }
  }
</style>
