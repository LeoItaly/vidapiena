---
/**
 * The booking section — direct booking (client decision 19 Aug 2026). WhatsApp is
 * the primary CTA (website traffic converts here, so Francesco keeps the full
 * price with no OTA commission), Instagram the secondary direct channel. The OTA
 * badges below are unlinked "also on these platforms" proof, never booking links
 * — nothing here reads tour.otaLinks anymore.
 *
 * The Bókun calendar is the self-serve twin of the same direct model: it shows
 * real availability and takes a booking REQUEST (the channel is set to
 * pay-on-arrival), so no card is charged on the site and Francesco still
 * collects the money himself.
 *
 * Since 6 Sep 2026 the calendar itself lives in the rail beside the description
 * (BookingRail.astro) and in the shared modal — NOT inline here. Two live
 * embeds of the same widget on one page is two iframes, two fetches and two
 * places to pick a date; this section keeps a trigger for the same modal, which
 * is what a visitor who scrolled straight to "Prenota" actually needs.
 */
import CalendarCta from '../CalendarCta.astro';
import PlatformBadges from '../PlatformBadges.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import { SITE } from '../../data/site';
import { t, type Locale } from '../../i18n';
import type { Tour } from '../../data/tours';

interface Props {
  tour: Tour;
  locale: Locale;
}
const { tour, locale } = Astro.props;
const dict = t(locale);
---

<section id="prenota" class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-10 md:py-20">
    <h2 class="font-display text-3xl font-bold md:text-4xl" data-reveal-heading>
      {dict.tourPage.bookingHeading}
    </h2>

    <p class="mt-4 max-w-prose leading-relaxed text-paper/85">{dict.booking.lead}</p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <WhatsAppButton locale={locale} tour={tour} />
      <a href={SITE.instagram} class="btn btn-ghost" rel="noopener" target="_blank">
        {dict.tourPage.instagramDm} · {SITE.instagramHandle}
      </a>
    </div>

    <div class="mt-8 border-t border-paper/15 pt-6">
      <p class="eyebrow text-paper/55">{dict.booking.calendarEyebrow}</p>
      <p class="mt-2 max-w-prose text-sm leading-relaxed text-paper/70">
        {dict.booking.calendarLead}
      </p>
      <CalendarCta
        tour={tour}
        locale={locale}
        variant="ghost"
        label={dict.booking.calendarCtaLong}
        class="mt-4 text-sm"
      />
      <noscript>
        <p class="mt-3 text-sm text-paper/70">{dict.booking.calendarNoscript}</p>
      </noscript>
    </div>

    <p class="eyebrow mt-12 text-paper/55">{dict.badges.heading}</p>
    <PlatformBadges class="mt-4" />
  </div>
</section>
