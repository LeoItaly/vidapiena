---
/**
 * Tour FAQ — a native <details> accordion. GEO-first: the answers ship in the
 * HTML source even while collapsed, so Google and AI assistants (ChatGPT,
 * Perplexity, Claude, Gemini) read every answer with no JavaScript. The same
 * `items` array feeds the FAQPage JSON-LD on the tour page, so the visible copy
 * and the structured data can never drift.
 *
 * Google largely retired FAQ rich-result *display* in 2023 for non-gov/health
 * sites — this is an AI-extraction and on-page-relevance play, not a SERP widget.
 */
interface Props {
  items: { q: string; a: string }[];
  heading: string;
}
const { items, heading } = Astro.props;
const headingId = 'faq-heading';
---

{
  items.length > 0 && (
    <section class="bg-paper text-ink" aria-labelledby={headingId}>
      <div class="mx-auto max-w-6xl px-5 pb-16 md:px-10 md:pb-24">
        <h2 id={headingId} class="font-display text-2xl font-bold md:text-3xl">
          {heading}
        </h2>
        <div class="mt-8 border-t border-ink/15">
          {items.map((item) => (
            <details class="faq-item border-b border-ink/15">
              <summary class="faq-summary flex cursor-pointer items-baseline justify-between gap-6 py-5">
                <span class="font-display text-lg font-semibold md:text-xl">{item.q}</span>
                <span class="faq-mark mt-1 flex-none font-mono text-xl leading-none text-verde">
                  +
                </span>
              </summary>
              <p class="max-w-prose pb-5 leading-relaxed text-ink-soft">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Drop the native disclosure triangle; the +/× mark carries the affordance. */
  .faq-summary {
    list-style: none;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-summary:hover > span:first-child {
    color: var(--color-verde);
  }
  /* Rotating the "+" 45° reads as "×" when open — a state cue with no extra glyph. */
  .faq-mark {
    transition: transform 0.25s var(--ease-vp, ease);
  }
  .faq-item[open] .faq-mark {
    transform: rotate(45deg);
  }
</style>
