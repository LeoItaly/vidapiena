---
/**
 * The small line icon inside a card action button on the dashboard.
 *
 * Inline SVG rather than an icon font or an image: it inherits `currentColor` (so
 * it matches the button's text in every state), ships nothing extra, and stays
 * self-contained — the back office has no icon dependency and should not grow one
 * for six glyphs. Decorative: the button carries the accessible label.
 */
interface Props {
  nome: 'modifica' | 'anteprima' | 'apri' | 'elimina' | 'offline' | 'online';
  class?: string;
}
const { nome, class: extra } = Astro.props;

const PATHS: Record<Props['nome'], string> = {
  // pencil
  modifica: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  // eye
  anteprima:
    '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
  // box-arrow-out (open the live page in a new tab)
  apri: '<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>',
  // trash
  elimina:
    '<path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M10 11v6M14 11v6"/>',
  // archive box (take offline — reversible)
  offline: '<rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><path d="M10 12h4"/>',
  // arrow up to a line (put back online)
  online: '<path d="M4 20h16"/><path d="M12 16V4"/><path d="m7 9 5-5 5 5"/>',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['h-4 w-4 shrink-0', extra]}
  aria-hidden="true"
  set:html={PATHS[nome]}
/>
