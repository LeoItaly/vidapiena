---
/**
 * The "see the free dates" trigger — the calendar-icon CTA that opens the shared
 * Bókun modal (BokunDialog.astro, one per page). It carries everything the modal
 * needs on data attributes, so the page can hold four of these and still ship a
 * single iframe that is only pointed at a tour when someone actually asks.
 *
 * It is a <button>, not a link: there is no URL to send anyone to — the target
 * is an in-page dialog. Without JS it is simply absent (see the `noscript`
 * fallbacks beside each call site), never a dead control.
 */
import { bokunCalendarSrc } from '../lib/bokun';
import { SITE } from '../data/site';
import { t, type Locale } from '../i18n';
import type { Tour } from '../data/tours';

interface Props {
  tour: Tour;
  locale: Locale;
  /** ouro CTA, or a bordered ghost on light / dark surfaces. */
  variant?: 'primary' | 'ghost' | 'ghost-ink';
  /** Icon only — the label stays for screen readers. */
  iconOnly?: boolean;
  label?: string;
  class?: string;
}
const {
  tour,
  locale,
  variant = 'ghost-ink',
  iconOnly = false,
  label,
  class: className = '',
} = Astro.props;

const dict = t(locale);
const name = dict.tours.items[tour.id].name;
const skin =
  variant === 'ghost' ? 'btn-ghost' : variant === 'primary' ? 'btn-primary' : 'btn-ghost-ink';
const text = label ?? dict.booking.calendarCta;
const wa = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(dict.booking.waPrefillTour(name))}`;
---

<button
  type="button"
  class:list={['btn', skin, iconOnly && 'vp-cal-icon', className]}
  data-bokun-open
  data-bokun-src={bokunCalendarSrc(tour.bokunId, locale)}
  data-bokun-name={name}
  data-bokun-title={dict.booking.calendarFrameTitle(name)}
  data-bokun-wa={wa}
  aria-label={iconOnly ? dict.booking.calendarAria(name) : undefined}
  title={iconOnly ? dict.booking.calendarAria(name) : undefined}
>
  <svg viewBox="0 0 24 24" class="h-[1.15em] w-[1.15em]" fill="none" aria-hidden="true">
    <rect
      x="3"
      y="5"
      width="18"
      height="16"
      rx="3"
      stroke="currentColor"
      stroke-width="1.7"></rect>
    <path
      d="M3 10h18M8 3v4M16 3v4"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"></path>
    {/* The free day. Decorative — the label carries the meaning. */}
    <circle cx="12" cy="15.5" r="1.9" fill="var(--color-verde)"></circle>
  </svg>
  <span class:list={[iconOnly && 'sr-only']}>{text}</span>
</button>

<style>
  /* Icon-only variant: a circle, not a squashed pill. 3rem is the measured
     height of the bordered .btn beside it on the tour cards — a square that is
     merely close reads as misaligned in a row of pills. */
  .vp-cal-icon {
    padding: 0;
    width: 3rem;
    height: 3rem;
    justify-content: center;
  }
  .vp-cal-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
