---
/**
 * A small related-content list — same visual language as the tour page's "other
 * tours" block. Generic: pass a heading and a list of { label, href, meta }.
 * Renders nothing when the list is empty, so callers can pass whatever they have.
 */
interface Props {
  heading: string;
  items: { label: string; href: string; meta?: string }[];
}
const { heading, items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="bg-paper text-ink">
      <div class="mx-auto max-w-6xl px-5 py-14 md:px-10 md:py-16">
        <h2 class="eyebrow text-ink/55">{heading}</h2>
        <ul class="mt-6 divide-y divide-ink/15 border-y border-ink/15">
          {items.map((item) => (
            <li>
              <a
                href={item.href}
                class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5"
              >
                <span class="font-display text-xl font-bold transition-colors group-hover:text-verde md:text-2xl">
                  {item.label}
                </span>
                {item.meta && <span class="font-mono text-sm text-ink/60">{item.meta}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
