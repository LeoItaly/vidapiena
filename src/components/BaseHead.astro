---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ogBase from '../assets/og/og-base.jpg';
import { getHeroPosters, POSTER_MEDIA } from '../lib/posters';
import displayFontUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import {
  t,
  pagePath,
  absoluteUrl,
  ogLocale,
  LOCALES,
  DEFAULT_LOCALE,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
  /** Locale-neutral page tail ('' = home) — drives canonical, hreflang, og:url. */
  path?: string;
  title?: string;
  description?: string;
  /** Social-card override (tour pages pass their hero photo). */
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Landing only: the hero posters are its LCP and must win the preload race. */
  preloadHeroPosters?: boolean;
  /** og:type — 'website' (default) or 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /** ISO-8601 — emitted as article:published_time only when ogType is 'article'. */
  articlePublishedTime?: string;
  /** ISO-8601 — emitted as article:modified_time only when ogType is 'article'. */
  articleModifiedTime?: string;
  /**
   * Robots directive. Default explicitly welcomes indexing and full rich
   * previews. Admin/404 never reach BaseHead (they set their own noindex), so
   * this index-follow default cannot leak into them.
   */
  robots?: string;
  /** Content author — the person behind the page. */
  author?: string;
}
const {
  locale,
  path = '',
  ogImage,
  ogImageAlt,
  preloadHeroPosters = false,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  author = 'Francesco — Vidapiena',
} = Astro.props;
const dict = t(locale);
const title = Astro.props.title ?? dict.meta.title;
const description = Astro.props.description ?? dict.meta.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = absoluteUrl(pagePath(locale, path));

const ogSource = ogImage ?? ogBase;
const og = await getImage({ src: ogSource, format: 'jpeg', width: 1200 });
const ogHeight = ogImage ? Math.round((1200 * ogImage.height) / ogImage.width) : 630;
const ogAlt = ogImageAlt ?? dict.meta.ogAlt;
const posters = preloadHeroPosters ? await getHeroPosters() : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="author" content={author} />
{
  /* Search-engine ownership tokens. Env-gated so the tags only appear once the
     repo variables are set — no empty content attributes before then. Bing's
     index feeds ChatGPT and Copilot, so both matter for GEO, not just Google. */
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
    <meta
      name="google-site-verification"
      content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
    />
  )
}
{
  import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
    <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
  )
}
<link rel="canonical" href={canonical} />
{LOCALES.map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(pagePath(l, path))} />)}
<link rel="alternate" hreflang="x-default" href={absoluteUrl(pagePath(DEFAULT_LOCALE, path))} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Vidapiena" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteUrl(og.src)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={ogAlt} />
<meta property="og:locale" content={ogLocale(locale)} />
{
  LOCALES.filter((l) => l !== locale).map((l) => (
    <meta property="og:locale:alternate" content={ogLocale(l)} />
  ))
}
{
  ogType === 'article' && articlePublishedTime && (
    <meta property="article:published_time" content={articlePublishedTime} />
  )
}
{
  ogType === 'article' && articleModifiedTime && (
    <meta property="article:modified_time" content={articleModifiedTime} />
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteUrl(og.src)} />

<meta name="theme-color" content="#10150f" />
<link rel="icon" href={`${base}/favicon.png`} sizes="32x32" />
<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

{
  posters && (
    <>
      <link
        rel="preload"
        as="image"
        href={posters.landscape.src}
        media={POSTER_MEDIA.landscape}
        fetchpriority="high"
      />
      <link
        rel="preload"
        as="image"
        href={posters.portrait.src}
        media={POSTER_MEDIA.portrait}
        fetchpriority="high"
      />
    </>
  )
}
<!-- Only the display face is preloaded — it renders the headline; the body face
     swaps in without competing with the poster (the LCP element) for 4G bandwidth. -->
<link rel="preload" as="font" type="font/woff2" href={displayFontUrl} crossorigin />

<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
