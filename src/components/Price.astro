---
/**
 * A single price, displayed in euro (€). Client decision 01/09/2026 (reverses
 * the 19/08 R$-only display): the site shows the fixed EUR twin from tours.ts to
 * every visitor. Still one currency, so the marketing pages stay fully static —
 * no per-request Worker CPU, no live FX. R$ remains the real on-the-ground
 * settlement currency (Francesco charges in reais); `brl` is kept as an optional
 * prop so the figure stays recorded and callers need not change their call sites.
 *
 * `class` styles the numeric run (font-size/weight/tabular-nums); surrounding
 * wording ("from" / "per person") lives in the dictionaries.
 */
interface Props {
  eur: number;
  brl?: number;
  class?: string;
}
const { eur, class: className = '' } = Astro.props;
---
<span class:list={['vp-price', className]}>€{eur}</span>
