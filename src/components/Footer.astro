---
import BrandBadge from './BrandBadge.astro';
import SocialGlyph from './SocialGlyph.astro';
import LangSwitch from './LangSwitch.astro';
import { SITE } from '../data/site';
import { t, pagePath, localeHref, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Locale-neutral tail of the current page — forwarded to LangSwitch. */
  path?: string;
}
const { locale, path = '' } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();

/* The full site map lives here too — it is the drawer's no-JS fallback and
   gives crawlers a plain-anchor path to every page. */
const links = [
  { label: dict.nav.home, href: pagePath(locale) },
  { label: dict.nav.tours, href: localeHref(locale, '#tour') },
  { label: dict.nav.blog, href: pagePath(locale, 'blog/') },
  { label: dict.nav.guide, href: pagePath(locale, 'la-guida/') },
  { label: dict.nav.contact, href: pagePath(locale, 'contatti/') },
];
---

<footer class="border-t border-paper/10 bg-ink text-paper">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-10 md:flex-row md:items-start md:justify-between md:px-10"
  >
    <div class="flex items-start gap-4">
      <BrandBadge size={56} class="size-14" />
      <div>
        <p class="font-display text-sm font-bold tracking-[0.28em] uppercase">Vidapiena</p>
        <p class="mt-2 text-sm text-paper/70">{dict.footer.line}</p>
      </div>
    </div>

    <nav aria-label={dict.nav.footerLabel}>
      <ul class="flex max-w-xs flex-wrap gap-x-6 gap-y-2.5 font-mono text-xs tracking-[0.18em] uppercase">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="link-sweep opacity-80 transition-opacity hover:opacity-100">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Social exits as labelled pills, not bare 20px glyphs: the handle is the
        point (people search "@vidapiena"), and TikTok now reads as loud as
        Instagram instead of disappearing into the footer rule. */}
    <div class="flex shrink-0 flex-wrap items-center gap-3">
      <a href={SITE.instagram} class="social-pill" rel="noopener" target="_blank">
        <SocialGlyph network="instagram" />
        <span>Instagram</span>
      </a>
      <a href={SITE.tiktok} class="social-pill" rel="noopener" target="_blank">
        <SocialGlyph network="tiktok" />
        <span>TikTok</span>
      </a>
      <LangSwitch locale={locale} path={path} />
    </div>
  </div>
  <p class="px-5 pb-6 text-center font-mono text-[0.65rem] text-paper/40 md:px-10">
    © {year} Vidapiena
  </p>
</footer>

<style>
  /* Bordered pill so each network is a visible target, not a hairline icon.
     Ouro on hover matches the drawer + CTA language. */
  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-paper) 28%, transparent);
    padding: 0.45rem 0.95rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .social-pill:hover,
  .social-pill:focus-visible {
    border-color: var(--color-ouro);
    color: var(--color-ouro);
  }
</style>
