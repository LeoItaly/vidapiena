# Dependencies & builds (for when coding starts)
node_modules/
dist/
build/
.next/
.astro/
# Astro's cacheDir, relocated out of node_modules so CI can cache it (see astro.config.mjs)
.astro-cache/
.svelte-kit/
.output/
.vercel/
.netlify/

# Env & secrets — never commit
.env
.env.*
!.env.example
# Wrangler local state, and the local secret file it reads in `wrangler dev`.
# .dev.vars holds the admin password hash and the GitHub token during local work.
.wrangler/
.dev.vars

# Local tooling
.claude/
*.local

# Build-time Instagram import — ephemeral, regenerated every build (scripts/fetch-instagram.mjs).
# Behold is the source of truth; committing these would only add daily binary churn.
src/assets/instagram/*.jpg
src/data/instagram-feed.json

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log
npm-debug.log*
